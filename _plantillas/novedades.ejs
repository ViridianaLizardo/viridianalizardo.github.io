```{=html}
<ul class="novedades list">
<% for (const item of items) { %>
  <li <%= metadataAttrs(item) %>>
    <span class="fecha"><%= item.date %></span>
    <a href="<%- item.path %>"><%= item.title %></a>
  </li>
<% } %>
<% if (items.length === 0) { %>
  <li><span class="fecha">pronto</span><span>Aquí aparecerán las entradas nuevas de la bitácora y del catálogo.</span></li>
<% } %>
</ul>
```
